DATABASE_PATH=./data/tagspy.db
# Public URL of this app, used for links inside alert messages
APP_URL=http://localhost:3000

# Server-side cache of public responses, in seconds. 0 (default) keeps no scan data on the server.
CACHE_SECONDS=0
MAX_RESPONSE_BYTES=6000000
RATE_LIMIT_PER_HOUR=120

# Site DNA scan budget (keep below the function limit: 60 s on Vercel Hobby)
SITE_SCAN_SECONDS=40
SITE_MAX_SCRIPTS=48

# Follow (history + alerts) is a planned paid feature; true turns it on (for testing)
NEXT_PUBLIC_FOLLOW_ENABLED=

# Hosted database (Turso / libSQL) so history and alerts persist on Vercel. Unset = local SQLite file.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Deep scan (headless Chromium). Required "true" in production; in development a local Chrome/Edge is used automatically.
DEEP_SCAN_ENABLED=
DEEP_SCAN_SECONDS=50
DEEP_SCAN_PER_VISIT=3
DEEP_SCAN_PER_HOUR=10
# Browser, first match wins: Cloudflare Browser Run (account ID + API token with "Browser Rendering - Edit"),
# BROWSER_WS_ENDPOINT (any remote CDP browser), CHROME_PATH (local executable), or on Linux the Chromium pack below
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CHROME_PATH=
BROWSER_WS_ENDPOINT=
CHROMIUM_PACK_URL=

# Vercel Cron (vercel.json) calls /api/cron/watch with this secret
CRON_SECRET=

# Watch/alerts worker (npm run worker)
WATCH_INTERVAL_HOURS=24
WATCH_POLL_SECONDS=300

# Optional email delivery for alerts, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
ALERTS_FROM=TagSpy alerts <alerts@example.com>

# Test-only. Never enable in production.
SCANNER_ALLOW_PRIVATE_HOSTS=false
